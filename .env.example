# Copiare in .env.local e compilare. Nessun valore è obbligatorio per avviare il sito.

# Indirizzo pubblico del sito, senza barra finale. DA CONFERMARE.
# Finché è vuoto, il sito chiede ai motori di ricerca di non indicizzarlo.
NEXT_PUBLIC_SITE_URL=

# Numero WhatsApp della locanda: solo cifre, con prefisso internazionale. DA CONFERMARE.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Invio email delle richieste con il servizio Resend (https://resend.com).
# Senza questi tre valori le richieste sono scritte nel log del server.
RESEND_API_KEY=
REQUEST_TO_EMAIL=
REQUEST_FROM_EMAIL=
